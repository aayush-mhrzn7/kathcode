---
interface Props {
	variant?: "header" | "edge";
}

const { variant = "header" } = Astro.props;
---

<kathcode-sidebar-toggle data-variant={variant} class:list={[variant]}>
	<button
		type="button"
		class="toggle"
		aria-controls="starlight__sidebar"
		aria-expanded="true"
		aria-label="Collapse sidebar"
	>
		{
			variant === "header" ? (
				<>
					<svg
						class="icon expanded"
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect width="18" height="18" x="3" y="3" rx="2"></rect>
						<path d="M9 3v18"></path>
						<path d="m16 15-3-3 3-3"></path>
					</svg>
					<svg
						class="icon collapsed"
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect width="18" height="18" x="3" y="3" rx="2"></rect>
						<path d="M9 3v18"></path>
						<path d="m14 9 3 3-3 3"></path>
					</svg>
				</>
			) : (
				<svg
					class="chevron"
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="m15 18-6-6 6-6"></path>
				</svg>
			)
		}
	</button>
</kathcode-sidebar-toggle>

<style>
	kathcode-sidebar-toggle.header {
		display: none;
	}

	kathcode-sidebar-toggle.edge {
		display: none;
	}

	.toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		cursor: pointer;
		color: var(--fg);
		background: transparent;
		line-height: 0;
	}

	.header .toggle {
		position: relative;
		width: 2rem;
		height: 2rem;
		border-radius: 0.375rem;
	}

	.header .toggle:hover {
		background: var(--gray-a4);
	}

	.icon,
	.chevron {
		width: 1.1rem;
		height: 1.1rem;
	}

	.icon {
		position: absolute;
		top: 50%;
		left: 50%;
		transition:
			transform 200ms ease,
			opacity 200ms ease;
	}

	.expanded {
		transform: translate(-50%, -50%) scale(1);
		opacity: 1;
	}

	.collapsed {
		transform: translate(-50%, -50%) scale(0.6);
		opacity: 0;
	}

	:global(html[data-sidebar-collapsed]) .expanded {
		transform: translate(-50%, -50%) scale(0.6);
		opacity: 0;
	}

	:global(html[data-sidebar-collapsed]) .collapsed {
		transform: translate(-50%, -50%) scale(1);
		opacity: 1;
	}

	.edge .toggle {
		width: 1.55rem;
		height: 1.55rem;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 999px;
		background: var(--bg);
		box-shadow: 0 4px 12px color-mix(in srgb, var(--navy-ink) 18%, transparent);
	}

	.edge .toggle:hover {
		border-color: var(--cyan);
		color: var(--cyan);
	}

	.chevron {
		transition: transform 200ms ease;
	}

	:global(html[data-sidebar-collapsed]) .chevron {
		transform: rotate(180deg);
	}

	@media (min-width: 50rem) {
		kathcode-sidebar-toggle.header {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2rem;
			height: 2rem;
		}

		kathcode-sidebar-toggle.edge {
			position: fixed;
			z-index: calc(var(--sl-z-index-menu) + 1);
			top: calc(var(--sl-nav-height) + 0.85rem);
			inset-inline-start: calc(var(--sl-content-inline-start, 0rem) - 0.8rem);
			display: block;
			transition: inset-inline-start 200ms ease;
		}

		:global(html[data-sidebar-collapsed]) kathcode-sidebar-toggle.edge {
			inset-inline-start: 0.55rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.icon,
		.chevron,
		kathcode-sidebar-toggle.edge {
			transition: none;
		}
	}
</style>

<script>
	const storageKey = "kathcode-sidebar";

	const isCollapsed = () => document.documentElement.hasAttribute("data-sidebar-collapsed");

	const apply = (collapsed: boolean) => {
		document.documentElement.toggleAttribute("data-sidebar-collapsed", collapsed);
		try {
			localStorage.setItem(storageKey, collapsed ? "collapsed" : "open");
		} catch {}

		document.querySelectorAll("kathcode-sidebar-toggle button").forEach((button) => {
			button.setAttribute("aria-expanded", String(!collapsed));
			button.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
		});
	};

	class KathcodeSidebarToggle extends HTMLElement {
		connectedCallback() {
			apply(isCollapsed());
			this.querySelector("button")?.addEventListener("click", () => apply(!isCollapsed()));
		}
	}

	if (!customElements.get("kathcode-sidebar-toggle")) {
		customElements.define("kathcode-sidebar-toggle", KathcodeSidebarToggle);
	}
</script>
