---
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import type { Props } from "@astrojs/starlight/props";
import SidebarToggle from "./SidebarToggle.astro";

const { hasSidebar } = Astro.props;
---

<div class="header sl-flex">
	<div class="brand sl-flex">
		<SiteTitle {...Astro.props} />
	</div>
	<div class="actions sl-flex">
		{hasSidebar && <SidebarToggle variant="header" />}
		<div class="social sl-flex">
			<SocialIcons {...Astro.props} />
		</div>
		<ThemeSelect {...Astro.props} />
	</div>
</div>

<style>
	.header {
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		width: 100%;
		height: 100%;
	}

	.brand {
		min-width: 0;
		align-items: center;
	}

	.brand :global(.site-title) {
		gap: 0;
	}

	.brand :global(img) {
		display: block;
		height: 2.75rem;
		width: auto;
		max-width: min(72vw, 16rem);
		object-fit: contain;
		object-position: left center;
		image-rendering: pixelated;
	}

	.actions {
		align-items: center;
		gap: 0.25rem;
		flex-shrink: 0;
		height: 2rem;
	}

	.social {
		align-items: center;
		height: 2rem;
	}

	.social :global(a) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: 0;
		border-radius: 0.375rem;
		color: var(--fg);
		background: transparent;
		padding: 0;
		margin: 0;
		line-height: 0;
	}

	.social :global(a:hover) {
		background: var(--gray-a4);
		opacity: 1;
	}

	.social :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}
</style>
