---
const prizes = [
	{
		place: "1st",
		label: "First place",
		amount: "50,000",
		blurb: "Champion team. The strongest build, the clearest demo, and the pitch that wins the room.",
	},
	{
		place: "2nd",
		label: "Second place",
		amount: "20,000",
		blurb: "Runner-up for a tight product and a convincing story on stage.",
	},
	{
		place: "3rd",
		label: "Third place",
		amount: "10,000",
		blurb: "A working prototype the judges remember, with a real problem behind it.",
	},
];
---

<section class="prizes" id="prizes">
	<p class="eyebrow" data-reveal>Prizes</p>
	<div class="intro" data-reveal style="--reveal-delay: 60ms">
		<h2>NRs 80,000 prize pool</h2>
		<p>
			Cash awards for the top three teams after 36 hours of building. Finalists pitch in a
			grand pitch presentation on 18th Ashoj, 2083 — the work has to hold up on stage, not just
			in the repo.
		</p>
	</div>
	<div class="bento">
		{
			prizes.map((prize, index) => (
				<article
					class:list={["card", prize.place === "1st" && "first"]}
					data-reveal
					style={`--reveal-delay: ${140 + index * 90}ms`}
				>
					<div class="copy">
						<p class="place">{prize.label}</p>
						<p class="blurb">{prize.blurb}</p>
					</div>
					<p class="amount"><span>NRs</span> {prize.amount}</p>
				</article>
			))
		}
	</div>
</section>

<style>
	.prizes {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--cyan);
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		max-width: 58ch;
		margin-bottom: 0.35rem;
	}

	h2 {
		margin: 0;
		color: var(--sl-color-white);
	}

	.intro p {
		margin: 0;
		line-height: 1.65;
		color: var(--sl-color-text);
	}

	.bento {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 0.85rem;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.1rem;
		padding: 1.35rem 1.4rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1rem;
		background: var(--gray-2);
		min-height: 8.5rem;
		overflow: hidden;
		transition:
			transform 220ms ease,
			border-color 220ms ease,
			box-shadow 220ms ease;
	}

	.card:hover {
		transform: translateY(-5px);
		border-color: color-mix(in srgb, var(--cyan) 42%, var(--sl-color-hairline));
		box-shadow: 0 14px 32px color-mix(in srgb, var(--navy-ink) 28%, transparent);
	}

	.first {
		grid-row: 1 / 3;
		background: var(--navy-deep);
		border-color: transparent;
		min-height: 16rem;
		padding: 1.6rem 1.7rem;
	}

	.first:hover {
		transform: translateY(-6px);
		border-color: transparent;
		box-shadow: 0 18px 40px color-mix(in srgb, var(--navy-deep) 55%, transparent);
	}

	.first::after {
		content: "";
		position: absolute;
		inset: -30% auto auto -20%;
		width: 70%;
		height: 55%;
		border-radius: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--cyan) 26%, transparent), transparent 70%);
		pointer-events: none;
		opacity: 0.55;
		transition:
			opacity 320ms ease,
			transform 500ms ease;
	}

	.first:hover::after {
		opacity: 0.9;
		transform: translate(12%, 10%) scale(1.08);
	}

	.copy {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.place {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--cyan);
	}

	.blurb {
		margin: 0;
		max-width: 28ch;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--sl-color-text);
	}

	.first .blurb {
		max-width: 22ch;
		font-size: 1.02rem;
		color: color-mix(in srgb, var(--white) 82%, var(--cyan));
	}

	.amount {
		position: relative;
		z-index: 1;
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.6rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--sl-color-white);
		letter-spacing: -0.04em;
		transition: letter-spacing 220ms ease;
	}

	.card:hover .amount {
		letter-spacing: -0.02em;
	}

	.amount span {
		font-size: 0.45em;
		font-weight: 600;
		margin-right: 0.2em;
		color: var(--cyan);
	}

	.first .amount {
		color: var(--white);
	}

	@media (max-width: 40rem) {
		.bento {
			grid-template-columns: 1fr;
			grid-template-rows: none;
		}

		.first {
			grid-row: auto;
			min-height: 12rem;
		}

		.blurb,
		.first .blurb {
			max-width: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.first::after,
		.amount {
			transition: none;
		}

		.card:hover,
		.first:hover {
			transform: none;
			box-shadow: none;
		}

		.first:hover::after {
			transform: none;
		}
	}
</style>
