---
interface Person {
	image: string;
	name: string;
	title: string;
}

interface Props {
	id: string;
	eyebrow: string;
	heading: string;
	description: string;
	people: Person[];
}

const { id, eyebrow, heading, description, people } = Astro.props;
---

<section class="people" {id}>
	<p class="eyebrow" data-reveal>{eyebrow}</p>
	<div class="intro" data-reveal style="--reveal-delay: 60ms">
		<h2>{heading}</h2>
		<p>{description}</p>
	</div>
	<ul class="grid">
		{
			people.map((person) => (
				<li>
					<article class="card">
						<img src={person.image} alt={person.name} width="600" height="400" loading="lazy" />
						<div class="meta">
							<h3>{person.name}</h3>
							<p>{person.title}</p>
						</div>
					</article>
				</li>
			))
		}
	</ul>
</section>

<style>
	.people {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--cyan);
	}

	h2 {
		margin: 0;
		color: var(--sl-color-white);
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		max-width: 58ch;
		margin-bottom: 0.35rem;
	}

	.intro p {
		margin: 0;
		line-height: 1.65;
		color: var(--sl-color-text);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.card {
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1rem;
		background: var(--gray-2);
		transition:
			transform 220ms ease,
			border-color 220ms ease,
			box-shadow 220ms ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--cyan) 35%, var(--sl-color-hairline));
		box-shadow: 0 12px 28px color-mix(in srgb, var(--navy-ink) 22%, transparent);
	}

	img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		background: var(--gray-3);
		transition: transform 420ms ease;
	}

	.card:hover img {
		transform: scale(1.04);
	}

	.meta {
		padding: 0.9rem 1rem 1.1rem;
	}

	h3 {
		margin: 0;
		font-size: 1.05rem;
		color: var(--sl-color-white);
	}

	.meta p {
		margin: 0.2rem 0 0;
		color: var(--sl-color-text);
		font-size: 0.9rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		img {
			transition: none;
		}

		.card:hover,
		.card:hover img {
			transform: none;
			box-shadow: none;
		}
	}
</style>
