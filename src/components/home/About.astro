---
const themes = ["Blockchain & Web3", "AI & ML", "Cyber Security"];
---

<section class="about" id="about" data-reveal>
	<p class="eyebrow">About</p>
	<h2>About the hackathon</h2>
	<div class="copy">
		<p>
			<span class="brand-kath">Kath</span><span class="brand-code">code</span> is a 72-hour
			hackathon at Kathford College of Engineering and Management. Participants collaborate,
			build, and pitch solutions to real-world problems, then present in a Shark-Tank style
			session on 4th Ashoj, 2082.
		</p>
		<p>
			The goal is to encourage innovation through design, prototypes, and presentations across
			education, healthcare, fintech, cybersecurity, agriculture, and more.
		</p>
	</div>
	<ul class="themes">
		{themes.map((theme) => <li>{theme}</li>)}
	</ul>
</section>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--cyan);
	}

	h2 {
		margin: 0;
		color: var(--sl-color-white);
	}

	.copy {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 62ch;
		color: var(--sl-color-text);
	}

	.copy p {
		margin: 0;
	}

	.themes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
	}

	.themes li {
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		font-size: 0.9rem;
		color: var(--sl-color-white);
		transition:
			border-color 180ms ease,
			color 180ms ease,
			background 180ms ease,
			transform 180ms ease;
	}

	.themes li:hover {
		border-color: var(--cyan);
		color: var(--cyan);
		background: color-mix(in srgb, var(--cyan) 10%, transparent);
		transform: translateY(-2px);
	}

	@media (prefers-reduced-motion: reduce) {
		.themes li {
			transition: none;
		}

		.themes li:hover {
			transform: none;
		}
	}
</style>
