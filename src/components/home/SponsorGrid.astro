---
interface Company {
	company_image: string;
	company_name: string;
}

interface SponsorGroup {
	category: string;
	companies: Company[];
}

interface Props {
	groups: SponsorGroup[];
}

const { groups } = Astro.props;
---

<section class="sponsors" id="sponsors">
	<p class="eyebrow" data-reveal>Sponsors</p>
	<div class="intro" data-reveal style="--reveal-delay: 60ms">
		<h2>Our sponsors</h2>
		<p>
			Partners who make the 36 hours possible — the room, the tracks, and the pitch. From Title
			to Silver, plus track sponsors who own a problem space. Want your name on this list?
			See the <a href="/sponsorship/sponsor/">sponsorship packs</a>.
		</p>
	</div>
	<div class="groups">
		{
			groups.map((group) => (
				<div class="group">
					<h3>{group.category}</h3>
					<ul>
						{group.companies.map((company) => (
							<li>
								<figure>
									<img
										src={company.company_image}
										alt={company.company_name}
										width="600"
										height="400"
										loading="lazy"
									/>
									<figcaption>{company.company_name}</figcaption>
								</figure>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.sponsors {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--cyan);
	}

	h2 {
		margin: 0;
		color: var(--sl-color-white);
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		max-width: 58ch;
		margin-bottom: 0.35rem;
	}

	.intro p {
		margin: 0;
		line-height: 1.65;
		color: var(--sl-color-text);
	}

	.groups {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	h3 {
		margin: 0 0 0.75rem;
		font-size: 0.95rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--navy);
	}

	:global(:root[data-theme="dark"]) h3 {
		color: var(--cyan);
	}

	ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 0.85rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	figure {
		margin: 0;
		padding: 0.85rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1rem;
		background: var(--gray-2);
		text-align: center;
		transition:
			transform 220ms ease,
			border-color 220ms ease,
			box-shadow 220ms ease;
	}

	figure:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--cyan) 38%, var(--sl-color-hairline));
		box-shadow: 0 10px 24px color-mix(in srgb, var(--navy-ink) 20%, transparent);
	}

	img {
		display: block;
		width: 100%;
		height: 5.5rem;
		object-fit: contain;
		background: var(--gray-3);
		border-radius: 0.5rem;
	}

	figcaption {
		margin-top: 0.6rem;
		font-size: 0.9rem;
		color: var(--sl-color-white);
	}

	@media (prefers-reduced-motion: reduce) {
		figure {
			transition: none;
		}

		figure:hover {
			transform: none;
			box-shadow: none;
		}
	}
</style>
