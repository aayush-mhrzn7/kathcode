---
import { Image } from "astro:assets";
import logoDark from "../assets/logo-dark.png";
import logoLight from "../assets/logo-light.png";

const year = new Date().getFullYear();

const company = [
	{ label: "About", href: "/introduction" },
	{ label: "Contact", href: "/contacts/contact/" },
	{ label: "Register", href: "/registration/register/" },
	{ label: "Sponsorship", href: "/sponsorship/sponsor/" },
	{ label: "Timeline", href: "/event-timeline/timeline/" },
];

const resources = [
	{ label: "Rulebook", href: "/rules/rules/" },
	{ label: "Selection", href: "/rules/selection/" },
	{ label: "Evaluation", href: "/rules/evaulate/" },
	{ label: "GitHub", href: "https://github.com/Kathford-IT-Club-KIC" },
];
---

<footer class="site-footer">
	<div class="inner">
		<div class="brand">
			<a href="/" class="logo" aria-label="KathCode">
				<Image
					class="light:sl-hidden"
					src={logoDark}
					alt=""
					width={928}
					height={278}
				/>
				<Image
					class="dark:sl-hidden"
					src={logoLight}
					alt=""
					width={928}
					height={278}
				/>
			</a>
			<p class="blurb">
				A 36-hour hackathon at Kathford College of Engineering and Management. We bring students,
				developers, and designers together to build solutions for real-world problems.
			</p>
			<p class="contact">
				For queries: <a href="mailto:itclub@kathford.edu.np">itclub@kathford.edu.np</a><br />
				Kathford College of Engineering and Management<br />
				Balkumari, Lalitpur
			</p>
			<p class="social-label">Social Media</p>
			<ul class="social">
				<li>
					<a href="https://github.com/Kathford-IT-Club-KIC" aria-label="GitHub">
						<svg viewBox="0 0 24 24" aria-hidden="true"
							><path
								fill="currentColor"
								d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"
							></path></svg
						>
					</a>
				</li>
				<li>
					<a href="https://www.instagram.com/kathforditclub/" aria-label="Instagram">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="5"></rect>
							<circle cx="12" cy="12" r="4"></circle>
							<circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
						</svg>
					</a>
				</li>
				<li>
					<a href="https://www.kathcode.kathford.edu.np/" aria-label="Website">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
							<circle cx="12" cy="12" r="9"></circle>
							<path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
						</svg>
					</a>
				</li>
			</ul>
		</div>

		<div class="links">
			<div>
				<p>Explore</p>
				<ul>
					{company.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</div>
			<div>
				<p>Resources</p>
				<ul>
					{resources.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<div class="bottom">
		<p>Copyright ©{year} Kathford IT Club. All rights reserved.</p>
		<p>
			<a href="/contacts/contact/">Contact</a>
			<span>|</span>
			<a href="/sponsorship/sponsor/">Sponsorship</a>
		</p>
	</div>

	<p class="watermark" aria-hidden="true">KATHCODE</p>
</footer>

<style>
	.site-footer {
		position: relative;
		overflow: hidden;
		margin-top: auto;
		margin-inline-start: var(--sl-content-inline-start, 0rem);
		padding: 4rem 1.5rem 2rem;
		border-top: 1px solid var(--border);
		background: var(--bg);
		color: var(--text-color);
		transition: margin-inline-start 200ms ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer {
			transition: none;
		}
	}

	.inner {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);
		gap: 3rem 4rem;
		max-width: 72rem;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}

	.logo {
		display: inline-block;
		margin: 0 0 1rem;
		line-height: 0;
		text-decoration: none;
	}

	.logo :global(img) {
		display: block;
		height: 2.75rem;
		width: auto;
		max-width: min(100%, 14rem);
		object-fit: contain;
		object-position: left center;
		image-rendering: pixelated;
	}

	.blurb,
	.contact {
		margin: 0 0 1rem;
		max-width: 36ch;
		font-size: 0.92rem;
		line-height: 1.7;
	}

	.contact a,
	.bottom a,
	.links a {
		color: var(--text-color);
		text-decoration: none;
	}

	.contact a:hover,
	.bottom a:hover,
	.links a:hover {
		color: var(--cyan);
	}

	.social-label,
	.links p {
		margin: 1.25rem 0 0.7rem;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--fg);
	}

	.links p {
		margin-top: 0;
		margin-bottom: 0.85rem;
	}

	.social {
		display: flex;
		gap: 0.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--gray-2);
		color: var(--fg);
	}

	.social a:hover {
		background: var(--cyan);
		border-color: var(--cyan);
		color: var(--bg);
	}

	.social svg {
		width: 1rem;
		height: 1rem;
	}

	.links {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-content: start;
	}

	.links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.bottom {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		max-width: 72rem;
		margin: 3.5rem auto 5.5rem;
		font-size: 0.82rem;
		position: relative;
		z-index: 1;
	}

	.bottom p {
		margin: 0;
	}

	.bottom span {
		margin: 0 0.5rem;
		opacity: 0.5;
	}

	.watermark {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.35em;
		margin: 0;
		text-align: center;
		font-size: clamp(4.5rem, 16vw, 11rem);
		font-weight: 800;
		letter-spacing: 0.08em;
		line-height: 0.8;
		color: transparent;
		-webkit-text-stroke: 1px var(--border);
		pointer-events: none;
		user-select: none;
	}

	@media (max-width: 50rem) {
		.inner,
		.bottom {
			grid-template-columns: 1fr;
		}

		.bottom {
			flex-direction: column;
			margin-bottom: 4rem;
		}
	}
</style>
